{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sovite:platform-bundle:v1alpha2",
  "title": "PlatformBundle",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "mode",
    "data_classes",
    "destinations",
    "models",
    "harnesses",
    "tools",
    "agents",
    "compute",
    "grants",
    "profiles",
    "restricted_class",
    "connector_roles"
  ],
  "properties": {
    "apiVersion": {
      "const": "sovite.platform/v1alpha2"
    },
    "kind": {
      "const": "PlatformBundle"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "display_name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
        },
        "display_name": {
          "type": "string",
          "maxLength": 16000
        },
        "description": {
          "type": "string",
          "maxLength": 16000
        },
        "version": {
          "type": "string",
          "maxLength": 16000
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "enum": [
        "development",
        "enforced"
      ]
    },
    "restricted_class": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
    },
    "discovery_class": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
    },
    "output_contracts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_class",
          "output_class",
          "destinations",
          "approvers",
          "procedure_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "name": {
            "type": "string",
            "maxLength": 16000
          },
          "description": {
            "type": "string",
            "maxLength": 16000
          },
          "source_class": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "output_class": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "destinations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
            },
            "uniqueItems": true,
            "maxItems": 100,
            "minItems": 1
          },
          "approvers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
            },
            "uniqueItems": true,
            "maxItems": 100,
            "minItems": 1
          },
          "procedure_ref": {
            "type": "object",
            "required": [
              "owner",
              "resource_id",
              "revision",
              "content_digest"
            ],
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$(?!\\n)"
              },
              "resource_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$(?!\\n)"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$(?!\\n)"
              },
              "content_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$(?!\\n)"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "default_profile": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
    },
    "data_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rank"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "name": {
            "type": "string",
            "maxLength": 16000
          },
          "description": {
            "type": "string",
            "maxLength": 16000
          },
          "rank": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "clearance",
          "kind",
          "trust_tier",
          "retention"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "name": {
            "type": "string",
            "maxLength": 16000
          },
          "description": {
            "type": "string",
            "maxLength": 16000
          },
          "clearance": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "kind": {
            "enum": [
              "local",
              "private",
              "cloud"
            ]
          },
          "boundary": {
            "enum": [
              "private",
              "public"
            ]
          },
          "allowed_hosts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "uniqueItems": true
          },
          "trust_tier": {
            "enum": [
              "operator-owned",
              "rented",
              "provider"
            ]
          },
          "retention": {
            "type": "object",
            "required": [
              "prompt_logging",
              "response_logging",
              "persistent_context",
              "in_memory_cache"
            ],
            "properties": {
              "prompt_logging": {
                "type": "boolean"
              },
              "response_logging": {
                "type": "boolean"
              },
              "persistent_context": {
                "type": "boolean"
              },
              "in_memory_cache": {
                "type": "object",
                "required": [
                  "scope",
                  "max_seconds",
                  "clear_on_cancel",
                  "clear_on_session_close"
                ],
                "properties": {
                  "scope": {
                    "const": "job"
                  },
                  "max_seconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "clear_on_cancel": {
                    "type": "boolean"
                  },
                  "clear_on_session_close": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "restricted_clearance": {
            "type": "object",
            "required": [
              "classes",
              "rationale",
              "authorization_ref"
            ],
            "properties": {
              "classes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
                },
                "uniqueItems": true,
                "maxItems": 100,
                "minItems": 1
              },
              "rationale": {
                "type": "string",
                "maxLength": 16000,
                "minLength": 1,
                "pattern": "\\S"
              },
              "authorization_ref": {
                "type": "string",
                "maxLength": 16000,
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "adapter",
          "model",
          "destination",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "name": {
            "type": "string",
            "maxLength": 16000
          },
          "description": {
            "type": "string",
            "maxLength": 16000
          },
          "adapter": {
            "enum": [
              "demo",
              "ollama",
              "openai-compatible",
              "codex-subscription",
              "claude-subscription",
              "opencode-go"
            ]
          },
          "endpoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$(?!\\n)"
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "wire_api": {
            "enum": [
              "chat",
              "responses"
            ]
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "identity_protocol": {
            "enum": [
              "ollama",
              "native-subscription",
              "provider-service"
            ]
          },
          "identity_endpoint": {
            "type": "string",
            "maxLength": 2048
          },
          "api_key_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
          },
          "tls_trust": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "max_concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "parameters": {
            "type": "object",
            "required": [],
            "properties": {
              "temperature": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "think": {
                "type": "boolean"
              },
              "reasoning_effort": {
                "enum": [
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh"
                ]
              },
              "num_predict": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32768
              },
              "num_ctx": {
                "type": "integer",
                "minimum": 128,
                "maximum": 1048576
              },
              "max_tokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32768
              },
              "seed": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          },
          "enabled": {
            "type": "boolean"
          },
          "connection": {
            "type": "object",
            "required": [
              "kind",
              "enrollment_role"
            ],
            "properties": {
              "kind": {
                "const": "model-gateway"
              },
              "enrollment_role": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
              }
            },
            "additionalProperties": false
          },
          "identity": {
            "type": "object",
            "required": [
              "protocol",
              "pinning"
            ],
            "properties": {
              "protocol": {
                "const": "helper-signed-v1"
              },
              "pinning": {
                "enum": [
                  "required",
                  "unpinned-development"
                ]
              },
              "engine_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "\\S"
              },
              "weights_manifest_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$(?!\\n)"
              }
            },
            "additionalProperties": false
          },
          "first_token_timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "cancel_bound_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "connection"
              ]
            },
            "then": {
              "required": [
                "identity",
                "wire_api",
                "max_concurrency",
                "timeout_seconds",
                "first_token_timeout_seconds",
                "cancel_bound_seconds"
              ]
            }
          }
        ]
      },
      "maxItems": 1000
    },
    "harnesses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "name": {
            "type": "string",
            "maxLength": 16000
          },
          "description": {
            "type": "string",
            "maxLength": 16000
          },
          "kind": {
            "enum": [
              "demo",
              "tool-agent",
              "native-codex",
              "native-claude",
              "native-opencode",
              "agent-http"
            ]
          },
          "image": {
            "type": "string",
            "maxLength": 16000
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$(?!\\n)"
          },
          "version": {
            "type": "string",
            "maxLength": 16000
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
            },
            "uniqueItems": true,
            "maxItems": 100
          },
          "endpoint": {
            "type": "string",
            "maxLength": 16000
          },
          "cancel_endpoint": {
            "type": "string",
            "maxLength": 16000
          },
          "api_key_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "idempotent": {
            "type": "boolean"
          },
          "authentication": {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "subscription"
              },
              "credential_file_env": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
              },
              "credential_env": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "input_class",
          "output_class",
          "destination",
          "allowed_operations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "name": {
            "type": "string",
            "maxLength": 16000
          },
          "description": {
            "type": "string",
            "maxLength": 16000
          },
          "kind": {
            "enum": [
              "http-json",
              "kubernetes-read"
            ]
          },
          "endpoint": {
            "type": "string",
            "maxLength": 16000
          },
          "input_class": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "output_class": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "allowed_operations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
            },
            "uniqueItems": true,
            "maxItems": 100
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "api_key_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
          },
          "namespace": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "read_only": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "harness",
          "model",
          "tools"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "name": {
            "type": "string",
            "maxLength": 16000
          },
          "description": {
            "type": "string",
            "maxLength": 16000
          },
          "harness": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
            },
            "uniqueItems": true,
            "maxItems": 100
          },
          "instructions": {
            "type": "string",
            "maxLength": 16000
          },
          "max_steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "version": {
            "type": "string",
            "maxLength": 16000
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "compute": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "destination"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "name": {
            "type": "string",
            "maxLength": 16000
          },
          "description": {
            "type": "string",
            "maxLength": 16000
          },
          "kind": {
            "enum": [
              "local",
              "kubernetes"
            ]
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "namespace": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "profile": {
            "type": "object",
            "required": [],
            "properties": {
              "accelerator": {
                "type": "string",
                "maxLength": 16000
              },
              "replicas": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "cpu": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "memory": {
                "type": "string",
                "maxLength": 16000
              },
              "worker_image": {
                "type": "string",
                "maxLength": 16000
              },
              "node_selector": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "agent",
          "callers",
          "input_class",
          "output_class",
          "compute",
          "state_destination",
          "telemetry_destination",
          "return_contract"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "name": {
            "type": "string",
            "maxLength": 16000
          },
          "description": {
            "type": "string",
            "maxLength": 16000
          },
          "agent": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "callers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
            },
            "uniqueItems": true,
            "maxItems": 100
          },
          "input_class": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "output_class": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "compute": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "state_destination": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "telemetry_destination": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "telemetry_class": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "receipt_class": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "caller_clearance": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$(?!\\n)"
          },
          "return_contract": {
            "enum": [
              "reference",
              "class-aware"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "result_readers": {
            "type": "array",
            "items": {
              "type": "string",
