        "properties": {
          "parent_run_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "source_digest": {
            "$ref": "#/components/schemas/DigestRef"
          },
          "contract_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "contract_revision": {
            "$ref": "#/components/schemas/DigestRef"
          },
          "expected_generation": {
            "$ref": "#/components/schemas/DigestRef"
          },
          "candidate_sha256": {
            "$ref": "#/components/schemas/Sha256"
          },
          "candidate_tip_sha": {
            "type": "string",
            "minLength": 40,
            "maxLength": 40,
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "FeedbackContextRequest": {
        "type": "object",
        "required": [
          "parent_run_id",
          "feedback_contract_id"
        ],
        "properties": {
          "parent_run_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "feedback_contract_id": {
            "$ref": "#/components/schemas/Identity"
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "GitSha": {
        "type": "string",
        "minLength": 40,
        "maxLength": 40,
        "pattern": "^[0-9a-f]{40}$"
      },
      "Identity": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "NativeActivation": {
        "type": "object",
        "required": [
          "schema_version",
          "job_id",
          "attempt_id",
          "workspace_id",
          "repository_id",
          "principal_id",
          "generation",
          "fence_sha256",
          "packet_sha256",
          "executor_id",
          "publication_revision",
          "qualification_ref",
          "vm_id",
          "deadline",
          "lease_until"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "enum": [
              "sovite-native-activation/v1"
            ]
          },
          "job_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "attempt_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "workspace_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "repository_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "principal_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "generation": {
            "$ref": "#/components/schemas/DigestRef"
          },
          "fence_sha256": {
            "$ref": "#/components/schemas/Sha256"
          },
          "packet_sha256": {
            "$ref": "#/components/schemas/Sha256"
          },
          "executor_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "publication_revision": {
            "$ref": "#/components/schemas/Identity"
          },
          "qualification_ref": {
            "$ref": "#/components/schemas/Identity"
          },
          "vm_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "deadline": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "lease_until": {
            "type": "number",
            "format": "double",
            "minimum": 0
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "OutputRelease": {
        "type": "string",
        "minLength": 72,
        "maxLength": 72,
        "pattern": "^release_[0-9a-f]{64}$"
      },
      "RecoveryCaptureRequest": {
        "type": "object",
        "required": [
          "workspace_id",
          "attempt_id"
        ],
        "properties": {
          "workspace_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "attempt_id": {
            "$ref": "#/components/schemas/Identity"
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "RecoveryCaptured": {
        "type": "object",
        "required": [
          "kind",
          "run_id",
          "attempt_id",
          "workspace_id",
          "repository_id",
          "base_sha",
          "tip_sha",
          "source_digest",
          "outcome",
          "publication_eligible",
          "repair_eligible"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "repository-recovery-artifact"
            ]
          },
          "run_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "attempt_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "workspace_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "repository_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "base_sha": {
            "$ref": "#/components/schemas/GitSha"
          },
          "tip_sha": {
            "$ref": "#/components/schemas/GitSha"
          },
          "source_digest": {
            "$ref": "#/components/schemas/DigestRef"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "uncertain",
              "interrupted",
              "failed",
              "cancelled"
            ]
          },
          "publication_eligible": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "repair_eligible": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "RecoveryContextRequest": {
        "type": "object",
        "required": [
          "workspace_id",
          "attempt_id",
          "source_digest",
          "contract_id",
          "destination_id"
        ],
        "properties": {
          "workspace_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "attempt_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "source_digest": {
            "$ref": "#/components/schemas/DigestRef"
          },
          "contract_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "destination_id": {
            "$ref": "#/components/schemas/Identity"
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "RecoveryReleaseContext": {
        "type": "object",
        "required": [
          "kind",
          "run_id",
          "attempt_id",
          "source_digest",
          "contract_id",
          "contract_revision",
          "expected_generation",
          "procedure_digest",
          "output_class",
          "destinations",
          "publication_eligible",
          "repair_eligible"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "repository-recovery-artifact"
            ]
          },
          "run_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "attempt_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "source_digest": {
            "$ref": "#/components/schemas/DigestRef"
          },
          "contract_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "contract_revision": {
            "$ref": "#/components/schemas/DigestRef"
          },
          "expected_generation": {
            "$ref": "#/components/schemas/DigestRef"
          },
          "procedure_digest": {
            "$ref": "#/components/schemas/DigestRef"
          },
          "output_class": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "destinations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Identity"
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "publication_eligible": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "repair_eligible": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "RecoveryReleaseRequest": {
        "type": "object",
        "required": [
          "workspace_id",
          "attempt_id",
          "source_digest",
          "contract_id",
          "destination_id",
          "expected_generation",
          "expected_contract_revision"
        ],
        "properties": {
          "workspace_id": {
            "$ref": "#/components/schemas/Identity"
          },
          "attempt_id": {
            "$ref": "#/components/schemas/Identity"
