  "components": {
    "schemas": {
      "DigestRef": {
        "type": "string",
        "minLength": 71,
        "maxLength": 71,
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "FeedbackContext": {
        "type": "object",
        "required": [
          "parent_run_id",
          "source_digest",
          "contract_id",
          "contract_revision",
          "expected_generation",
          "candidate_sha256",
          "candidate_tip_sha"
