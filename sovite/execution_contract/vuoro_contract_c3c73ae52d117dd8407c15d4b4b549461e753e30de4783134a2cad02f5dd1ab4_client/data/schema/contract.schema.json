{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "contract.schema.json",
    "$defs": {
        "PullRequest": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "PullRequest.json",
            "type": "object",
            "properties": {
                "instance_id": {
                    "$ref": "InstanceId.json"
                },
                "operation_id": {
                    "$ref": "OperationId.json"
                }
            },
            "required": [
                "instance_id",
                "operation_id"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "InstanceId": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "InstanceId.json",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
        },
        "OperationId": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "OperationId.json",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
        },
        "ExecutionIdentity": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "ExecutionIdentity.json",
            "type": "object",
            "properties": {
                "instance_id": {
                    "$ref": "InstanceId.json"
                },
                "job_id": {
                    "$ref": "JobId.json"
                },
                "generation": {
                    "$ref": "Generation.json"
                },
                "fence": {
                    "$ref": "Fence.json"
                }
            },
            "required": [
                "instance_id",
                "job_id",
                "generation",
                "fence"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "JobId": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "JobId.json",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
        },
        "Generation": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "Generation.json",
            "type": "string",
            "minLength": 71,
            "maxLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "Fence": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "Fence.json",
            "type": "string",
            "minLength": 32,
            "maxLength": 32,
            "pattern": "^[0-9a-f]{32}$"
        },
        "StartRequest": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "StartRequest.json",
            "type": "object",
            "properties": {
                "instance_id": {
                    "$ref": "InstanceId.json"
                },
                "job_id": {
                    "$ref": "JobId.json"
                },
                "generation": {
                    "$ref": "Generation.json"
                },
                "fence": {
                    "$ref": "Fence.json"
                },
                "operation_id": {
                    "$ref": "OperationId.json"
                }
            },
            "required": [
                "instance_id",
                "job_id",
                "generation",
                "fence",
                "operation_id"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "RenewRequest": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "RenewRequest.json",
            "type": "object",
            "properties": {
                "instance_id": {
                    "$ref": "InstanceId.json"
                },
                "job_id": {
                    "$ref": "JobId.json"
                },
                "generation": {
                    "$ref": "Generation.json"
                },
                "fence": {
                    "$ref": "Fence.json"
                },
                "operation_id": {
                    "$ref": "OperationId.json"
                }
            },
            "required": [
                "instance_id",
                "job_id",
                "generation",
                "fence",
                "operation_id"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "StatusRequest": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "StatusRequest.json",
            "type": "object",
            "properties": {
                "instance_id": {
                    "$ref": "InstanceId.json"
                },
                "job_id": {
                    "$ref": "JobId.json"
                },
                "generation": {
                    "$ref": "Generation.json"
                },
                "fence": {
                    "$ref": "Fence.json"
                }
            },
            "required": [
                "instance_id",
                "job_id",
                "generation",
                "fence"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "HandbackRequest": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "HandbackRequest.json",
            "type": "object",
            "properties": {
                "instance_id": {
                    "$ref": "InstanceId.json"
                },
                "job_id": {
                    "$ref": "JobId.json"
                },
                "generation": {
                    "$ref": "Generation.json"
                },
                "fence": {
                    "$ref": "Fence.json"
                },
                "operation_id": {
                    "$ref": "OperationId.json"
                }
            },
            "required": [
                "instance_id",
                "job_id",
                "generation",
                "fence",
                "operation_id"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "LookupRequest": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "LookupRequest.json",
            "type": "object",
            "properties": {
                "instance_id": {
                    "$ref": "InstanceId.json"
                },
                "operation_id": {
                    "$ref": "OperationId.json"
                }
            },
            "required": [
                "instance_id",
                "operation_id"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "AgentHttpRecipe": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "AgentHttpRecipe.json",
            "type": "object",
            "properties": {
                "profile": {
                    "type": "string",
                    "const": "agent-http-v1"
                },
                "agent_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 96
                },
                "endpoint": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16000
                },
                "cancel_endpoint": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16000
                },
                "credential_env": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 96,
                    "pattern": "^[A-Z][A-Z0-9_]+$"
                },
                "idempotent": {
                    "type": "boolean"
                },
                "timeout_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                }
            },
            "required": [
                "profile",
                "agent_id",
                "endpoint",
                "idempotent",
                "timeout_seconds"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "ReservedJob": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "ReservedJob.json",
            "type": "object",
            "properties": {
                "job_id": {
                    "$ref": "JobId.json"
                },
                "generation": {
                    "$ref": "Generation.json"
                },
                "fence": {
                    "$ref": "Fence.json"
                },
                "lease_until": {
                    "$ref": "UnixSeconds.json"
                },
                "task": {
                    "type": "string",
                    "maxLength": 3500000
                },
                "recipe": {
                    "$ref": "AgentHttpRecipe.json"
                }
            },
            "required": [
                "job_id",
                "generation",
                "fence",
                "lease_until",
                "task",
                "recipe"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "UnixSeconds": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "UnixSeconds.json",
            "type": "number",
            "minimum": 1e-16
        },
        "PullIdle": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "PullIdle.json",
            "type": "object",
            "properties": {
                "state": {
                    "type": "string",
                    "const": "idle"
                }
            },
            "required": [
                "state"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "PullReserved": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "PullReserved.json",
            "type": "object",
            "properties": {
                "state": {
                    "type": "string",
                    "const": "reserved"
                },
                "job": {
                    "$ref": "ReservedJob.json"
                }
            },
            "required": [
                "state",
                "job"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "Started": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "Started.json",
            "type": "object",
            "properties": {
                "state": {
                    "type": "string",
                    "const": "started"
                },
                "job_id": {
                    "$ref": "JobId.json"
                },
                "generation": {
                    "$ref": "Generation.json"
                },
                "fence": {
                    "$ref": "Fence.json"
                },
                "lease_until": {
                    "$ref": "UnixSeconds.json"
                },
                "deadline": {
                    "$ref": "UnixSeconds.json"
                }
            },
            "required": [
                "state",
                "job_id",
                "generation",
                "fence",
                "lease_until",
                "deadline"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "AlreadyStarted": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "AlreadyStarted.json",
            "type": "object",
            "properties": {
                "state": {
                    "type": "string",
                    "const": "already_started"
                },
                "job_id": {
                    "$ref": "JobId.json"
                },
                "generation": {
                    "$ref": "Generation.json"
                },
                "fence": {
                    "$ref": "Fence.json"
                }
            },
            "required": [
                "state",
                "job_id",
                "generation",
                "fence"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "Renewed": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "Renewed.json",
            "type": "object",
            "properties": {
                "state": {
                    "type": "string",
                    "const": "renewed"
                },
                "job_id": {
                    "$ref": "JobId.json"
                },
                "generation": {
                    "$ref": "Generation.json"
                },
                "fence": {
                    "$ref": "Fence.json"
                },
                "lease_until": {
                    "$ref": "UnixSeconds.json"
                },
                "deadline": {
                    "$ref": "UnixSeconds.json"
                }
            },
            "required": [
                "state",
                "job_id",
                "generation",
                "fence",
                "lease_until",
                "deadline"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "ExecutionStatus": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "ExecutionStatus.json",
            "type": "object",
            "properties": {
                "state": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "current"
                        },
                        {
                            "type": "string",
                            "const": "superseded"
                        },
                        {
                            "type": "string",
                            "const": "finished"
                        },
                        {
                            "type": "string",
                            "const": "expired"
                        }
                    ]
                },
                "job_id": {
                    "$ref": "JobId.json"
                },
                "generation": {
                    "$ref": "Generation.json"
                },
                "fence": {
                    "$ref": "Fence.json"
                },
                "phase": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "reserved"
                        },
                        {
                            "type": "string",
                            "const": "started"
                        },
                        {
                            "type": "string",
                            "const": "finished"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "job_status": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "queued"
                        },
                        {
                            "type": "string",
                            "const": "running"
                        },
                        {
                            "type": "string",
                            "const": "retry_wait"
                        },
                        {
                            "type": "string",
                            "const": "completed"
                        },
                        {
                            "type": "string",
                            "const": "failed"
                        },
                        {
                            "type": "string",
                            "const": "cancelled"
                        },
                        {
                            "type": "string",
                            "const": "blocked"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "lease_until": {
                    "anyOf": [
                        {
                            "$ref": "UnixSeconds.json"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "deadline": {
                    "anyOf": [
                        {
                            "$ref": "UnixSeconds.json"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "state",
                "job_id",
                "generation",
                "fence",
                "phase",
                "job_status",
                "lease_until",
                "deadline"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "HandedBack": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "HandedBack.json",
            "type": "object",
            "properties": {
                "state": {
                    "type": "string",
                    "const": "handed_back"
                },
                "job_id": {
                    "$ref": "JobId.json"
                },
                "generation": {
                    "$ref": "Generation.json"
                },
                "fence": {
                    "$ref": "Fence.json"
                },
                "disposition": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "retry_wait"
                        },
                        {
                            "type": "string",
                            "const": "blocked"
                        },
                        {
                            "type": "string",
                            "const": "cancelled"
                        }
                    ]
                }
            },
            "required": [
                "state",
                "job_id",
                "generation",
                "fence",
                "disposition"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "Completion": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "Completion.json",
            "type": "object",
            "properties": {
                "state": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "completed"
                        },
                        {
                            "type": "string",
                            "const": "failed"
                        },
                        {
                            "type": "string",
                            "const": "cancelled"
                        },
                        {
                            "type": "string",
                            "const": "retry_wait"
                        },
                        {
                            "type": "string",
                            "const": "blocked"
                        }
                    ]
                },
                "job_id": {
                    "$ref": "JobId.json"
                },
                "generation": {
                    "$ref": "Generation.json"
                },
                "fence": {
                    "$ref": "Fence.json"
                },
                "error_code": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "artifact_sha256": {
                    "type": "string"
                }
            },
            "required": [
                "state",
                "job_id",
                "generation",
                "fence"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "OperationFound": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "OperationFound.json",
            "type": "object",
            "properties": {
                "state": {
                    "type": "string",
                    "const": "found"
                },
                "operation_id": {
                    "$ref": "OperationId.json"
                },
                "operation_kind": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "pull"
                        },
                        {
                            "type": "string",
                            "const": "start"
                        },
                        {
                            "type": "string",
                            "const": "renew"
                        },
                        {
                            "type": "string",
                            "const": "handback"
                        },
                        {
                            "type": "string",
                            "const": "complete"
                        }
                    ]
                },
                "job_id": {
                    "anyOf": [
                        {
                            "$ref": "JobId.json"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "fence": {
                    "anyOf": [
                        {
                            "$ref": "Fence.json"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "result_state": {
                    "anyOf": [
                        {
                            "type": "string",
                            "const": "idle"
                        },
                        {
                            "type": "string",
                            "const": "reserved"
                        },
                        {
                            "type": "string",
                            "const": "started"
                        },
                        {
                            "type": "string",
                            "const": "already_started"
                        },
                        {
                            "type": "string",
                            "const": "renewed"
                        },
                        {
                            "type": "string",
                            "const": "handed_back"
                        },
                        {
                            "type": "string",
                            "const": "completed"
                        },
                        {
                            "type": "string",
                            "const": "failed"
                        },
                        {
                            "type": "string",
                            "const": "cancelled"
                        },
                        {
                            "type": "string",
                            "const": "retry_wait"
                        },
                        {
                            "type": "string",
                            "const": "blocked"
                        }
                    ]
                }
            },
            "required": [
                "state",
                "operation_id",
                "operation_kind",
                "job_id",
                "fence",
                "result_state"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "CompleteRequest": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "CompleteRequest.json",
            "type": "object",
            "properties": {
                "instance_id": {
                    "$ref": "InstanceId.json"
                },
                "job_id": {
                    "$ref": "JobId.json"
                },
                "generation": {
                    "$ref": "Generation.json"
                },
                "fence": {
                    "$ref": "Fence.json"
                },
                "operation_id": {
                    "$ref": "OperationId.json"
                },
                "outcome": {
                    "$ref": "WorkerOutcome.json"
                },
                "result_json": {
                    "type": "string",
                    "maxLength": 60000
                },
                "error_code": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "instance_id",
                "job_id",
                "generation",
                "fence",
                "operation_id",
                "outcome"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "WorkerOutcome": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "WorkerOutcome.json",
            "anyOf": [
                {
                    "type": "string",
                    "const": "completed"
                },
                {
                    "type": "string",
                    "const": "failed"
                },
                {
                    "type": "string",
                    "const": "retryable_failure"
                },
                {
                    "type": "string",
                    "const": "cancelled"
                }
            ]
        },
        "ErrorDetail": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "ErrorDetail.json",
            "type": "object",
            "properties": {
                "code": {
                    "$ref": "ExecutionErrorCode.json"
                },
                "message": {
                    "type": "string"
                }
            },
            "required": [
                "code",
                "message"
            ],
            "unevaluatedProperties": {
                "not": {}
            }
        },
        "ExecutionErrorCode": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "ExecutionErrorCode.json",
            "anyOf": [
                {
                    "type": "string",
                    "const": "invalid_request"
                },
                {
                    "type": "string",
                    "const": "execution_scope_denied"
                },
                {
                    "type": "string",
                    "const": "execution_profile_unavailable"
                },
                {
                    "type": "string",
                    "const": "idempotency_conflict"
                },
                {
                    "type": "string",
                    "const": "execution_fenced"
                },
                {
                    "type": "string",
                    "const": "cancelled"
                },
                {
                    "type": "string",
                    "const": "owner_unavailable"
                },
                {
                    "type": "string",
                    "const": "execution_payload_too_large"
                },
                {
                    "type": "string",
                    "const": "not_found"
                },
                {
                    "type": "string",
                    "const": "previous_attempt_unavailable"
                },
                {
                    "type": "string",
                    "const": "previous_attempt_unfinished"
                },
                {
                    "type": "string",
                    "const": "previous_effect_uncertain"
                },
                {
                    "type": "string",
                    "const": "adapter_credential_missing"
                },
                {
                    "type": "string",
                    "const": "agent_endpoint_missing"
                },
                {
                    "type": "string",
                    "const": "authorization_revoked"
                },
                {
                    "type": "string",
                    "const": "execution_failed"
                },
                {
                    "type": "string",
                    "const": "execution_timeout"
                },
                {
                    "type": "string",
                    "const": "external_execution_uncertain"
                },
                {
                    "type": "string",
                    "const": "incompatible_demo_configuration"
                },
                {
                    "type": "string",
                    "const": "internal_execution_error"
                },
                {
                    "type": "string",
                    "const": "invalid_tool_calls"
                },
                {
                    "type": "string",
                    "const": "model_empty_result"
                },
                {
                    "type": "string",
                    "const": "model_gateway_adapter_unavailable"
                },
                {
                    "type": "string",
                    "const": "model_identity_missing"
                },
                {
                    "type": "string",
                    "const": "model_identity_mismatch"
                },
                {
                    "type": "string",
                    "const": "model_identity_protocol_unsupported"
                },
                {
                    "type": "string",
                    "const": "model_identity_unpinned"
                },
